# Copy this file to `.env`, then restart `npm run dev` after you change it.

# Your personal Assignment 4 API URL from Vercel. No trailing slash.
VITE_API_LOC=https://assignment-4-database-and-authentic-puce.vercel.app

# Your Supabase project settings. Find these in Supabase → Project Settings → API.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
